// Main Grafana Alloy configuration - Modular structure
// Each service (Caddy, Authelia, etc.) is defined in its own section

// ============================================================================
// LOKI CLIENT CONFIGURATION
// ============================================================================
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ============================================================================
// DOCKER DISCOVERY - Shared by all services
// ============================================================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// ============================================================================
// CADDY LOG COLLECTION - Reverse proxy with GeoIP enrichment
// ============================================================================
discovery.relabel "caddy" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/caddy"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
}

loki.source.docker "caddy" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.caddy.output
  forward_to = [loki.process.caddy_json.receiver]
}

loki.process "caddy_json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level          = "level",
      ts             = "ts",
      request_uri    = "request.uri",
      request_method = "request.method",
      request_host   = "request.host",
      request_proto  = "request.proto",
      status         = "status",
      duration       = "duration",
      size           = "size",
      remote_ip      = "request.remote_ip",
      client_ip      = "request.client_ip",
      user_agent     = "request.headers.User-Agent[0]",
    }
  }

  stage.geoip {
    source   = "client_ip"
    db       = "/etc/geoip/GeoLite2-City.mmdb"
    db_type  = "city"
  }

  stage.labels {
    values = {
      level                = "level",
      request_host         = "request_host",
      request_method       = "request_method",
      status               = "status",
      client_ip            = "client_ip",
      geoip_country_name   = "geoip_country_name",
      geoip_city_name      = "geoip_city_name",
      geoip_latitude       = "geoip_location_latitude",
      geoip_longitude      = "geoip_location_longitude",
      job                  = "",
    }
  }

  stage.static_labels {
    values = {
      job = "caddy",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "Unix"
  }
}

// ============================================================================
// AUTHELIA LOG COLLECTION - Authentication service
// ============================================================================
discovery.relabel "authelia" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/authelia"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
}

loki.source.docker "authelia" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.authelia.output
  forward_to = [loki.process.authelia.receiver]
}

loki.process "authelia" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level      = "level",
      msg        = "msg",
      time       = "time",
      method     = "method",
      path       = "path",
      remote_ip  = "remote_ip",
      username   = "username",
    }
  }

  stage.labels {
    values = {
      level    = "level",
      method   = "method",
      username = "username",
      job      = "",
    }
  }

  stage.static_labels {
    values = {
      job = "authelia",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339"
  }
}

